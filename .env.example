# Local values only. This is the single local env file: `vp dev` and the build read it,
# and Wrangler (`vp run preview`, e2e) falls back to it because there is no .dev.vars.
# Deployed Workers get secrets from `wrangler secret put`, never from this file.

# --- Worker values (ORIGIN overrides wrangler.jsonc `vars`; secrets are in `secrets.required`) ---
# Base URL of the app, e.g. http://localhost:5173 for `vp dev`.
ORIGIN=""
# At least 32 characters with high entropy, e.g. `openssl rand -base64 32`.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# --- Tooling only (drizzle-kit `db:*` scripts; never reaches the Worker) ---
CLOUDFLARE_ACCOUNT_ID=""
# ID of the remote D1 database drizzle-kit targets: the same value as the `database_id` of the
# environment you mean (staging or production) in wrangler.jsonc. drizzle-kit never touches local D1.
CLOUDFLARE_DATABASE_ID=""
# API token with D1 edit permission.
CLOUDFLARE_D1_TOKEN=""
